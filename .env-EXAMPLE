# ==============================================
# DIRECTUS BACKEND CONFIGURATION
# ==============================================

# Admin User
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=SecurePassword123

# Public URL (debe coincidir con donde esté accesible el backend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8055

# Database Configuration
DATABASE_NAME=directus
DATABASE_USERNAME=directus
DATABASE_PASSWORD=SecureDBPassword123

# Directus Secret (genera uno con: openssl rand -base64 32)
DIRECTUS_SECRET=your-secret-key-here

# Email Configuration (SMTP)
EMAIL_FROM=noreply@example.com
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SECURE=false
SMTP_IGNORE_TLS=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3060

# ==============================================
# NEXT.JS FRONTEND CONFIGURATION
# ==============================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3060
NEXTAUTH_SECRET=your-nextauth-secret-here

# Backend URL for frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8055
